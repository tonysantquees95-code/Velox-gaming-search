{
  "name": "velox-windows",
  "productName": "Velox",
  "version": "1.0.0",
  "description": "Velox Search para Windows",
  "main": "main.js",
  "author": "Vetorial Tech",
  "private": true,
  "scripts": {
    "start": "electron .",
    "preparar": "node preparar.js",
    "dist": "node preparar.js && electron-builder --win portable nsis --publish never",
    "test": "node --test teste/*.test.js"
  },
  "build": {
    "appId": "tech.vetorial.velox.windows",
    "productName": "Velox",
    "files": [
      "main.js",
      "preload.js",
      "preload-paginas.js",
      "cofre.js",
      "crx.js",
      "bloqueio.js",
      "sincronia.js",
      "ui/**",
      "inicio/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Velox-Portatil-${version}.exe"
    },
    "nsis": {
      "artifactName": "Velox-Instalador-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "25.1.8"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.0.0"
  }
}